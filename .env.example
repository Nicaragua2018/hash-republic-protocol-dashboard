# Ejemplo del archivo .env del VPS (/docker/hrp-dashboard/.env).
# Copiar como .env y completar. Los secretos van solo en el servidor, nunca aquí.

# --- Sitio ---
SITE_HOST=opencivicsolutions.org

# --- Comentarios del blog (Remark42) ---
REMARK_SECRET=
REMARK_ADMIN_PASSWD=
# Inicio de sesión con GitHub para moderar (opcional).
AUTH_GITHUB_CID=
AUTH_GITHUB_CSEC=

# --- Boletín (Listmonk) ---
BOLETIN_HOST=boletin.opencivicsolutions.org
BOLETIN_DB_PASSWORD=
BOLETIN_ADMIN_USER=
BOLETIN_ADMIN_PASSWORD=
BOLETIN_BORRADORES_TOKEN=
BOLETIN_REMITENTE=info@opencivicsolutions.org
BOLETIN_GLOBAL_LIMIT=100

# --- HONEY, el asistente (honey/README.md) ---
# Clave de console.anthropic.com. Sin ella, HONEY queda apagado.
ANTHROPIC_API_KEY=
# 1 = encendido (solo después de la evaluación y con autorización); 0 = apagado.
HONEY_ACTIVO=0
HONEY_MODELO=anthropic:claude-haiku-5-5
HONEY_LIMITE_DIARIO=300
